# Normalize to LF in the repo. The Odoo server is Linux: Python and XML must
# not arrive with CRLF.
* text=auto eol=lf

*.py   text eol=lf
*.xml  text eol=lf
*.csv  text eol=lf
*.sh   text eol=lf
*.html text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.md    text eol=lf

# Binary
*.png  binary
*.jpg  binary
*.zip  binary
