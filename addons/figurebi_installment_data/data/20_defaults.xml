<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="default_payment_type" model="ir.default">
            <field name="field_id" ref="field_so_payment_type"/>
            <field name="json_value">"installment"</field>
        </record>
        <record id="default_periodicity" model="ir.default">
            <field name="field_id" ref="field_so_periodicity"/>
            <field name="json_value">"1"</field>
        </record>
        <record id="default_first_tranche_pct" model="ir.default">
            <field name="field_id" ref="field_so_first_tranche_pct"/>
            <field name="json_value">10.0</field>
        </record>
        <record id="default_final_balloon_pct" model="ir.default">
            <field name="field_id" ref="field_so_final_balloon_pct"/>
            <field name="json_value">80.0</field>
        </record>
        <record id="default_bank_rate" model="ir.default">
            <field name="field_id" ref="field_so_bank_rate"/>
            <field name="json_value">14.0</field>
        </record>
        <record id="default_bank_term" model="ir.default">
            <field name="field_id" ref="field_so_bank_term_months"/>
            <field name="json_value">120</field>
        </record>

        <!-- service product used on installment invoices -->
        <record id="product_installment_fee" model="product.template">
            <field name="name">განვადების შენატანი</field>
            <field name="default_code">INSTALLMENT-FEE</field>
            <field name="type">service</field>
            <field name="list_price">0</field>
        </record>
    </data>
</odoo>
