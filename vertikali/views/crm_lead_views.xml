<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Units on the opportunity: pick them visually, see them outlined on
         the plan, and reserve them, all without leaving the lead. -->
    <record id="view_crm_lead_form_vertikali" model="ir.ui.view">
        <field name="name">crm.lead.form.vertikali</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <!-- The modifiers below reference these; they must be present
                     in the view even when the base form does not carry them. -->
                <field name="type" invisible="1"/>
                <field name="vk_unit_count" invisible="1"/>
                <button name="action_vk_pick_units" type="object"
                        string="Choose Units" icon="fa-building-o"
                        invisible="type != 'opportunity'"/>
                <button name="action_vk_show_units" type="object"
                        string="Show on Plan"
                        invisible="type != 'opportunity' or vk_unit_count == 0"/>
                <button name="action_vk_reserve" type="object"
                        string="Reserve" class="btn-primary"
                        invisible="type != 'opportunity' or vk_unit_count == 0"
                        confirm="This creates and confirms a sale order, which takes the units off the market. Continue?"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Units" name="vertikali_units"
                      invisible="type != 'opportunity'">
                    <field name="vk_unit_ids" nolabel="1">
                        <list create="0" delete="1">
                            <field name="default_code"/>
                            <field name="vk_building"/>
                            <field name="vk_floor"/>
                            <field name="vk_rooms"/>
                            <field name="vk_area_total"/>
                            <field name="list_price"/>
                            <field name="vk_state" widget="badge"
                                   decoration-success="vk_state == 'available'"
                                   decoration-warning="vk_state == 'reserved'"
                                   decoration-muted="vk_state == 'sold'"/>
                        </list>
                    </field>
                    <div class="text-muted small">
                        Attaching a unit holds nothing -- only Reserve takes
                        it off the market. Pick units visually with the
                        Choose Units button.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- The pipeline card names the units the deal is about, so the board
         reads "who wants which flat" without opening anything. -->
    <record id="view_crm_lead_kanban_vertikali" model="ir.ui.view">
        <field name="name">crm.lead.kanban.vertikali</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']" position="inside">
                <div t-if="record.vk_unit_codes.raw_value"
                     class="o_vk_kanban_units text-muted small">
                    ▦ <field name="vk_unit_codes"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
