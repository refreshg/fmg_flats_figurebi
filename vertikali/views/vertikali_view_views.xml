<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ project: which navigation steps are in use ============ -->
    <record id="view_vertikali_project_list" model="ir.ui.view">
        <field name="name">vertikali.project.list</field>
        <field name="model">vertikali.project</field>
        <field name="arch" type="xml">
            <list string="Projects">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="building"/>
                <field name="categ_id"/>
                <field name="use_masterplan" string="Masterplan"/>
                <field name="use_facade" string="Facade"/>
                <field name="use_floorplan" string="Floor Plan"/>
                <field name="use_grid" string="Grid"/>
            </list>
        </field>
    </record>

    <record id="view_vertikali_project_form" model="ir.ui.view">
        <field name="name">vertikali.project.form</field>
        <field name="model">vertikali.project</field>
        <field name="arch" type="xml">
            <form string="Project">
                <header>
                    <button name="action_generate_floor_views" type="object"
                            string="Generate Floor Views"
                            class="btn-primary"
                            invisible="not use_floorplan"
                            help="Create one floor-plan view per floor that has units, and link the facade zones to them."/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Green Quarter"/></h1>
                        <field name="tagline" placeholder="e.g. Tbilisi, Saburtalo"/>
                    </div>
                    <group>
                        <group>
                            <field name="building" placeholder="e.g. A"
                                   help="Leave empty when the project has blocks."/>
                            <field name="categ_id"/>
                            <field name="handover" placeholder="e.g. Q4 2027"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="unit_count"/>
                            <field name="available_count"/>
                            <field name="price_from"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Short description shown on the project card…"/>
                    <group string="Navigation Steps">
                        <group>
                            <label for="use_masterplan"/>
                            <div>
                                <field name="use_masterplan" nolabel="1"/>
                                <span class="text-muted d-block small">
                                    Site plan of the whole complex — one zone per
                                    building. Only needed with several buildings.
                                </span>
                            </div>
                            <label for="use_facade"/>
                            <div>
                                <field name="use_facade" nolabel="1"/>
                                <span class="text-muted d-block small">
                                    One building's render — one zone per floor.
                                </span>
                            </div>
                        </group>
                        <group>
                            <label for="use_floorplan"/>
                            <div>
                                <field name="use_floorplan" nolabel="1"/>
                                <span class="text-muted d-block small">
                                    Top-down plan of a single storey — one zone per
                                    unit. Needs one image per floor.
                                </span>
                            </div>
                            <label for="use_grid"/>
                            <div>
                                <field name="use_grid" nolabel="1"/>
                                <span class="text-muted d-block small">
                                    Floor-by-floor table. No image required.
                                </span>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Blocks" name="blocks">
                            <field name="block_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="floors"/>
                                    <field name="facade_view_id"/>
                                    <field name="color" widget="color"/>
                                    <field name="unit_count" string="Units"/>
                                    <field name="available_count" string="Free"/>
                                    <field name="points" optional="hide"/>
                                </list>
                            </field>
                            <p class="text-muted small mt-2">
                                Add one block per tower. Leave this empty for a
                                single-building project.
                            </p>
                        </page>
                        <page string="Views" name="views">
                            <field name="view_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="view_type"/>
                                    <field name="building"/>
                                    <field name="floor"/>
                                    <field name="polygon_count" string="Zones"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_vertikali_projects" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">vertikali.project</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up a project</p>
            <p>Choose which steps buyers go through: facade → floor plan → unit,
               or straight to the grid.</p>
        </field>
    </record>

    <record id="view_vertikali_view_list" model="ir.ui.view">
        <field name="name">vertikali.view.list</field>
        <field name="model">vertikali.view</field>
        <field name="arch" type="xml">
            <list string="Visual Views"
                  decoration-muted="not has_image">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="view_type"/>
                <field name="project_id" optional="show"/>
                <field name="building" optional="show"/>
                <field name="floor" optional="show"/>
                <field name="section" optional="show"/>
                <field name="has_image" string="Image" widget="boolean_toggle"
                       readonly="1"/>
                <field name="polygon_count" string="Zones"/>
            </list>
        </field>
    </record>

    <record id="view_vertikali_view_form" model="ir.ui.view">
        <field name="name">vertikali.view.form</field>
        <field name="model">vertikali.view</field>
        <field name="arch" type="xml">
            <form string="Visual View">
                <header>
                    <button name="action_copy_image_to_floors" type="object"
                            string="Copy Plan + Zones to All Floors"
                            class="btn-primary"
                            invisible="view_type != 'floor' or not has_image"
                            confirm="This replaces the plan and the zones on every other floor of this project and section. Unit links on those floors will be cleared. Continue?"
                            help="Apply this drawing and its outlines to every other floor of the same project and section."/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Building A - facade"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="view_type"/>
                            <field name="building"
                                   invisible="view_type == 'masterplan'"/>
                            <field name="floor"
                                   invisible="view_type != 'floor'"/>
                            <field name="section"
                                   placeholder="empty = whole floor"
                                   invisible="view_type != 'floor'"/>
                        </group>
                        <group>
                            <field name="categ_id"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Zones" name="zones">
                            <field name="polygon_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="floor"/>
                                    <field name="target_view_id"/>
                                    <field name="product_tmpl_id"/>
                                    <field name="points" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_vertikali_view_search" model="ir.ui.view">
        <field name="name">vertikali.view.search</field>
        <field name="model">vertikali.view</field>
        <field name="arch" type="xml">
            <!-- All <field> elements come first, then filters, then the
                 group-by box: RelaxNG rejects fields appearing after
                 filters ("search has extra content: field"), and `expand`
                 is not a valid attribute on <group> in Odoo 19. -->
            <search string="Visual Views">
                <field name="name"/>
                <field name="building"/>
                <field name="categ_id"/>
                <separator/>
                <filter name="f_masterplan" string="Masterplans"
                        domain="[('view_type', '=', 'masterplan')]"/>
                <filter name="f_facade" string="Facades"
                        domain="[('view_type', '=', 'facade')]"/>
                <filter name="f_floor" string="Floor Plans"
                        domain="[('view_type', '=', 'floor')]"/>
                <group>
                    <filter name="g_type" string="Type"
                            context="{'group_by': 'view_type'}"/>
                    <filter name="g_building" string="Building"
                            context="{'group_by': 'building'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- The visual selector itself: an OWL client action, because Odoo has no
         built-in view type that renders clickable regions over an image. -->
    <record id="action_vertikali_selector" model="ir.actions.client">
        <field name="name">Building Selector</field>
        <field name="tag">vertikali_selector</field>
    </record>

    <record id="action_vertikali_views" model="ir.actions.act_window">
        <field name="name">Visual Views</field>
        <field name="res_model">vertikali.view</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a visual view</p>
            <p>Upload a masterplan, facade or floor plan, then draw the
               clickable zones on top of it.</p>
        </field>
    </record>

</odoo>
