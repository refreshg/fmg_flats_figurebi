<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The values the old Selection carried, so an upgraded database keeps
         its vocabulary. noupdate: the team renames and extends these freely
         from Configuration, and an upgrade must not undo that. -->
    <data noupdate="1">
        <record id="option_cond_frame" model="vertikali.option">
            <field name="name">Frame</field>
            <field name="attribute">condition</field>
            <field name="sequence">10</field>
        </record>
        <record id="option_cond_white" model="vertikali.option">
            <field name="name">White frame</field>
            <field name="attribute">condition</field>
            <field name="sequence">20</field>
        </record>
        <record id="option_cond_green" model="vertikali.option">
            <field name="name">Green frame</field>
            <field name="attribute">condition</field>
            <field name="sequence">30</field>
        </record>
        <record id="option_cond_renovated" model="vertikali.option">
            <field name="name">Renovated</field>
            <field name="attribute">condition</field>
            <field name="sequence">40</field>
        </record>
    </data>
</odoo>
