<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="vertikali.Selector">
        <div class="o_vk_selector d-flex flex-column h-100">

            <div class="o_vk_bar d-flex align-items-center gap-2 p-2 flex-wrap">
                <span class="o_vk_kicker">Visual selector</span>
                <select class="form-select form-select-sm w-auto"
                        t-on-change="(ev) => this.loadView(parseInt(ev.target.value))">
                    <t t-foreach="state.views" t-as="v" t-key="v.id">
                        <option t-att-value="v.id"
                                t-att-selected="state.view and v.id === state.view.id">
                            <t t-esc="v.name"/>
                        </option>
                    </t>
                </select>

                <button class="btn btn-sm"
                        t-att-class="state.editing ? 'btn-primary' : 'btn-secondary'"
                        t-on-click="toggleEdit">
                    <t t-esc="state.editing ? 'Editing zones' : 'Edit zones'"/>
                </button>

                <t t-if="state.editing">
                    <button class="btn btn-sm btn-secondary" t-on-click="startDraw"
                            t-att-disabled="state.drawing">+ Draw zone</button>
                    <button class="btn btn-sm btn-secondary"
                            t-on-click="duplicateDown"
                            t-att-disabled="!state.selected or state.drawing"
                            title="Copy the selected zone one band lower">
                        Copy down
                    </button>
                    <button class="btn btn-sm btn-secondary"
                            t-on-click="repeatDown"
                            t-att-disabled="!state.selected or state.drawing"
                            title="Stack many copies below the selected zone">
                        Repeat…
                    </button>
                    <button class="btn btn-sm btn-secondary"
                            t-on-click="applyShapeToAll"
                            t-att-disabled="!state.selected or state.drawing"
                            title="Copy the selected zone's outline to every other zone, keeping each floor's height">
                        Shape → all
                    </button>
                    <button class="btn btn-sm btn-secondary"
                            t-on-click="distributeBetweenEnds"
                            t-att-disabled="state.drawing"
                            title="Place the top and bottom zone, then spread the rest evenly between them">
                        Distribute
                    </button>
                    <button class="btn btn-sm btn-primary" t-on-click="saveShapes"
                            t-att-disabled="!state.dirty.size">
                        Save<t t-if="state.dirty.size"> (<t t-esc="state.dirty.size"/>)</t>
                    </button>
                    <button class="btn btn-sm btn-link text-danger"
                            t-on-click="deleteAllZones"
                            t-att-disabled="!state.zones.length">
                        Clear all
                    </button>
                </t>

                <span class="o_vk_meta">
                    <t t-esc="state.zones.length"/> zones
                </span>
            </div>

            <div t-if="state.editing" class="o_vk_hint px-2 py-1">
                <t t-if="state.drawing">
                    <b>Click as many corners as you need</b> — follow the roofline
                    step by step. <t t-esc="state.draft.length"/> placed.
                    Finish by clicking the first point again, or:
                    <button class="btn btn-link btn-sm p-0 ms-2" t-on-click="undoPoint">undo point</button>
                    <button class="btn btn-link btn-sm p-0 ms-2" t-on-click="finishDraw">finish</button>
                    <button class="btn btn-link btn-sm p-0 ms-2" t-on-click="cancelDraw">cancel</button>
                </t>
                <t t-else="">
                    Trace one band with <b>+ Draw zone</b> (any number of points),
                    then <b>Copy down</b> for the next one or <b>Repeat…</b> to
                    stack the whole facade. Drag a zone or its corners to adjust;
                    click a hollow edge handle to add a bend, right-click a corner
                    to remove it. Changes save on <b>Save</b>.
                </t>
            </div>

            <div t-if="state.error" class="alert alert-danger m-3"><t t-esc="state.error"/></div>
            <div t-elif="state.loading" class="text-muted p-4">Loading…</div>
            <div t-elif="!state.view" class="p-4">
                <h4>No visual view yet</h4>
                <p class="text-muted">
                    Create one under Estate → Configuration → Visual Views.
                </p>
            </div>

            <div t-else="" class="o_vk_body d-flex flex-grow-1 overflow-hidden">

                <div class="o_vk_stage flex-grow-1 position-relative"
                     t-ref="stage"
                     t-att-class="{ 'o_vk_drawing': state.drawing }"
                     t-on-click="onStageClick">

                    <img t-if="imageSrc" t-att-src="imageSrc" t-ref="img"
                         class="o_vk_img" alt="View background"
                         t-on-load="onImageLoad"/>
                    <div t-else="" class="o_vk_noimg">
                        <div>
                            <strong>No image uploaded</strong>
                            <div class="small">
                                Open this view and upload the building render.
                            </div>
                        </div>
                    </div>

                    <!-- Sized onto the rendered image box, not the container:
                         object-fit letterboxes the image, so matching the
                         container would drift whenever the ratios differ. -->
                    <svg class="o_vk_svg" viewBox="0 0 1 1"
                         preserveAspectRatio="none"
                         t-attf-style="left:{{state.box.left}}px;top:{{state.box.top}}px;width:{{state.box.width}}px;height:{{state.box.height}}px">

                        <t t-foreach="state.zones" t-as="z" t-key="z.id">
                            <polygon class="o_vk_zone"
                                     t-att-class="{
                                        'o_vk_zone_sel': state.selected and state.selected.id === z.id,
                                        'o_vk_zone_edit': state.editing }"
                                     t-att-points="attr(z.pts)"
                                     t-on-click="() => this.onZoneClick(z)"
                                     t-on-pointerdown="(ev) => this.startDragZone(ev, z)"/>
                        </t>

                        <!-- Handles for the selected zone: corners to drag,
                             edge midpoints to add a bend. -->
                        <t t-if="state.editing and state.selected">
                            <t t-foreach="edgeMidpoints(state.selected.pts)" t-as="m" t-key="'m'+m.i">
                                <circle class="o_vk_mid"
                                        t-att-cx="m.x" t-att-cy="m.y" r="0.006"
                                        t-on-click.stop="() => this.addPointAfter(state.selected, m.i)">
                                    <title>Add a point here</title>
                                </circle>
                            </t>
                            <t t-foreach="state.selected.pts" t-as="p" t-key="p_index">
                                <circle class="o_vk_vtx"
                                        t-att-cx="p[0]" t-att-cy="p[1]" r="0.009"
                                        t-on-pointerdown="(ev) => this.startDragVertex(ev, state.selected, p_index)"
                                        t-on-contextmenu.prevent.stop="() => this.removePoint(state.selected, p_index)">
                                    <title>Drag to move · right-click to remove</title>
                                </circle>
                            </t>
                        </t>

                        <!-- In-progress shape. The first point is drawn larger:
                             clicking it again closes the polygon. -->
                        <t t-if="state.draft.length">
                            <polygon t-if="state.draft.length > 1"
                                     class="o_vk_draft" t-att-points="attr(state.draft)"/>
                            <t t-foreach="state.draft" t-as="p" t-key="p_index">
                                <circle t-att-class="p_index === 0 ? 'o_vk_vtx o_vk_first' : 'o_vk_vtx'"
                                        t-att-cx="p[0]" t-att-cy="p[1]"
                                        t-att-r="p_index === 0 ? 0.012 : 0.006"/>
                            </t>
                        </t>
                    </svg>
                </div>

                <div class="o_vk_side">
                    <div class="o_vk_side_h">Zones</div>
                    <div class="o_vk_list">
                        <t t-foreach="state.zones" t-as="z" t-key="z.id">
                            <div class="o_vk_row d-flex align-items-center"
                                 t-att-class="{ 'o_vk_row_sel': state.selected and state.selected.id === z.id }"
                                 t-on-click="() => this.onZoneClick(z)">
                                <span class="flex-grow-1">
                                    <span class="o_vk_row_n"><t t-esc="z.name"/></span>
                                    <span class="o_vk_row_m" t-if="z.product_tmpl_id">
                                        <t t-esc="z.product_tmpl_id[1]"/>
                                    </span>
                                    <span class="o_vk_row_m" t-elif="z.target_view_id">
                                        → <t t-esc="z.target_view_id[1]"/>
                                    </span>
                                    <span class="o_vk_row_m" t-elif="z.floor">
                                        Floor <t t-esc="z.floor"/>
                                    </span>
                                </span>
                                <span class="o_vk_dot" t-if="state.dirty.has(z.id)" title="Unsaved">●</span>
                                <button t-if="state.editing" class="o_vk_del"
                                        t-on-click.stop="() => this.deleteZone(z)"
                                        title="Delete zone">×</button>
                            </div>
                        </t>
                        <div t-if="!state.zones.length" class="o_vk_row_m p-3">
                            No zones on this view yet.
                        </div>
                    </div>

                    <div class="o_vk_act" t-if="state.selected">
                        <div class="o_vk_kicker">Selected</div>
                        <div class="o_vk_sel_n"><t t-esc="state.selected.name"/></div>
                        <button t-if="state.selected.product_tmpl_id"
                                class="btn btn-primary btn-sm w-100 mt-2"
                                t-on-click="() => this.openUnit(state.selected)">
                            Open unit
                        </button>
                        <button t-if="state.selected.floor"
                                class="btn btn-secondary btn-sm w-100 mt-2"
                                t-on-click="() => this.showFloorUnits(state.selected)">
                            Show units on this floor
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
