<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="vertikali.Selector">
        <div class="o_vk_selector d-flex flex-column h-100">

            <!-- Project, then the steps that project actually uses. -->
            <div class="o_vk_steps d-flex align-items-center gap-3 px-2 pt-2 flex-wrap"
                 t-if="state.projects.length">
                <select class="form-select form-select-sm w-auto"
                        t-on-change="(ev) => this.selectProject(state.projects.find(p => p.id === parseInt(ev.target.value)))">
                    <t t-foreach="state.projects" t-as="p" t-key="p.id">
                        <option t-att-value="p.id"
                                t-att-selected="state.project and p.id === state.project.id">
                            <t t-esc="p.name"/>
                        </option>
                    </t>
                </select>

                <div class="o_vk_tabs d-flex">
                    <t t-foreach="steps" t-as="s" t-key="s.key">
                        <button class="o_vk_tab"
                                t-att-class="{ 'o_vk_tab_on': state.mode === s.key }"
                                t-on-click="() => this.setMode(s.key)">
                            <span class="o_vk_tab_i"><t t-esc="s.icon"/></span>
                            <span><t t-esc="s.label"/></span>
                        </button>
                    </t>
                </div>
            </div>

            <div class="o_vk_bar d-flex align-items-center gap-2 p-2 flex-wrap">
                <select t-if="modeViews.length > 1"
                        class="form-select form-select-sm w-auto"
                        t-on-change="(ev) => this.loadView(parseInt(ev.target.value))">
                    <t t-foreach="modeViews" t-as="v" t-key="v.id">
                        <option t-att-value="v.id"
                                t-att-selected="state.view and v.id === state.view.id">
                            <t t-esc="v.name"/>
                        </option>
                    </t>
                </select>
                <span t-elif="state.view" class="o_vk_kicker"><t t-esc="state.view.name"/></span>

                <!-- Back up a step after drilling into a floor. -->
                <button t-if="state.mode === 'floor' and state.project and state.project.use_facade"
                        class="btn btn-sm btn-link p-0"
                        t-on-click="() => this.setMode('facade')">
                    ← back to facade
                </button>

                <button t-if="state.mode !== 'grid'" class="btn btn-sm"
                        t-att-class="state.editing ? 'btn-primary' : 'btn-secondary'"
                        t-on-click="toggleEdit">
                    <t t-esc="state.editing ? 'Editing zones' : 'Edit zones'"/>
                </button>

                <t t-if="state.editing and state.mode !== 'grid'">
                    <button class="btn btn-sm btn-secondary" t-on-click="startDraw"
                            t-att-disabled="state.drawing">+ Draw zone</button>
                    <button class="btn btn-sm btn-secondary"
                            t-on-click="duplicateDown"
                            t-att-disabled="!state.selected or state.drawing"
                            title="Copy the selected zone one band lower">
                        Copy down
                    </button>
                    <button class="btn btn-sm btn-secondary"
                            t-on-click="repeatDown"
                            t-att-disabled="!state.selected or state.drawing"
                            title="Stack many copies below the selected zone">
                        Repeat…
                    </button>
                    <button class="btn btn-sm btn-secondary"
                            t-on-click="applyShapeToAll"
                            t-att-disabled="!state.selected or state.drawing"
                            title="Copy the selected zone's outline to every other zone, keeping each floor's height">
                        Shape → all
                    </button>
                    <button class="btn btn-sm btn-secondary"
                            t-on-click="distributeBetweenEnds"
                            t-att-disabled="state.drawing"
                            title="Place the top and bottom zone, then spread the rest evenly between them">
                        Distribute
                    </button>
                    <button class="btn btn-sm btn-primary" t-on-click="saveShapes"
                            t-att-disabled="!state.dirty.size">
                        Save<t t-if="state.dirty.size"> (<t t-esc="state.dirty.size"/>)</t>
                    </button>
                    <button class="btn btn-sm btn-link text-danger"
                            t-on-click="deleteAllZones"
                            t-att-disabled="!state.zones.length">
                        Clear all
                    </button>
                </t>

                <span class="o_vk_meta">
                    <t t-esc="state.zones.length"/> zones
                </span>
            </div>

            <div t-if="state.editing and state.mode !== 'grid'" class="o_vk_hint px-2 py-1">
                <t t-if="state.drawing">
                    <b>Click as many corners as you need</b> — follow the roofline
                    step by step. <t t-esc="state.draft.length"/> placed.
                    Finish by clicking the first point again, or:
                    <button class="btn btn-link btn-sm p-0 ms-2" t-on-click="undoPoint">undo point</button>
                    <button class="btn btn-link btn-sm p-0 ms-2" t-on-click="finishDraw">finish</button>
                    <button class="btn btn-link btn-sm p-0 ms-2" t-on-click="cancelDraw">cancel</button>
                </t>
                <t t-else="">
                    Trace one band with <b>+ Draw zone</b> (any number of points),
                    then <b>Copy down</b> or <b>Repeat…</b> to stack the facade.
                    Drag a zone or its corners to adjust. Select a zone and press
                    <b>Delete</b> to remove it. Changes save on <b>Save</b>.
                </t>
            </div>

            <div t-if="state.error" class="alert alert-danger m-3"><t t-esc="state.error"/></div>
            <div t-elif="state.loading" class="text-muted p-4">Loading…</div>

            <!-- Grid: no image, the units themselves are the interface. -->
            <div t-elif="state.mode === 'grid'" class="o_vk_body d-flex flex-grow-1 overflow-hidden">

                <div class="d-flex flex-column flex-grow-1 overflow-hidden">

                    <!-- filters -->
                    <div class="o_vk_filters d-flex align-items-center gap-3 px-3 py-2 flex-wrap">
                        <div class="d-flex align-items-center gap-1">
                            <span class="o_vk_flabel">Layout</span>
                            <t t-foreach="layouts" t-as="r" t-key="r">
                                <button class="o_vk_chip"
                                        t-att-class="{ 'o_vk_chip_on': state.filters.rooms.includes(r) }"
                                        t-on-click="() => this.toggleFilter('rooms', r)">
                                    <t t-esc="r"/>
                                </button>
                            </t>
                        </div>

                        <div class="d-flex align-items-center gap-1">
                            <span class="o_vk_flabel">Status</span>
                            <button class="o_vk_chip o_vk_chip_free"
                                    t-att-class="{ 'o_vk_chip_on': state.filters.status.includes('available') }"
                                    t-on-click="() => this.toggleFilter('status', 'available')">Free</button>
                            <button class="o_vk_chip o_vk_chip_res"
                                    t-att-class="{ 'o_vk_chip_on': state.filters.status.includes('reserved') }"
                                    t-on-click="() => this.toggleFilter('status', 'reserved')">Reserved</button>
                            <button class="o_vk_chip o_vk_chip_sold"
                                    t-att-class="{ 'o_vk_chip_on': state.filters.status.includes('sold') }"
                                    t-on-click="() => this.toggleFilter('status', 'sold')">Sold</button>
                        </div>

                        <div class="d-flex align-items-center gap-1">
                            <span class="o_vk_flabel">m²</span>
                            <input type="number" class="o_vk_num" placeholder="from"
                                   t-att-value="state.filters.areaMin"
                                   t-on-input="(ev) => (state.filters.areaMin = parseFloat(ev.target.value) || null)"/>
                            <input type="number" class="o_vk_num" placeholder="to"
                                   t-att-value="state.filters.areaMax"
                                   t-on-input="(ev) => (state.filters.areaMax = parseFloat(ev.target.value) || null)"/>
                        </div>

                        <div class="d-flex align-items-center gap-1">
                            <span class="o_vk_flabel">Max price</span>
                            <input type="number" class="o_vk_num o_vk_num_w" placeholder="any"
                                   t-att-value="state.filters.priceMax"
                                   t-on-input="(ev) => (state.filters.priceMax = parseFloat(ev.target.value) || null)"/>
                        </div>

                        <button t-if="filterActive" class="btn btn-sm btn-link p-0"
                                t-on-click="clearFilters">clear</button>

                        <span class="o_vk_meta ms-auto">
                            <t t-esc="matchCount"/> / <t t-esc="state.units.length"/> units
                        </span>
                    </div>

                    <!-- legend -->
                    <div class="o_vk_legend d-flex gap-3 px-3 py-1">
                        <span><i class="o_vk_sw o_vk_sw_free"></i>Free</span>
                        <span><i class="o_vk_sw o_vk_sw_res"></i>Reserved</span>
                        <span><i class="o_vk_sw o_vk_sw_sold"></i>Sold</span>
                    </div>

                    <div class="flex-grow-1 overflow-auto p-3">
                        <div t-if="!state.units.length" class="text-muted">
                            No units for this project yet.
                        </div>
                        <table t-else="" class="o_vk_gtable">
                            <thead>
                                <tr>
                                    <th class="o_vk_gcorner"></th>
                                    <t t-foreach="sections" t-as="s" t-key="s">
                                        <th class="o_vk_gsec">
                                            <t t-if="s">Section <t t-esc="s"/></t>
                                            <t t-else="">Units</t>
                                        </th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="gridRows" t-as="row" t-key="row.floor">
                                    <tr>
                                        <th class="o_vk_gfloor">
                                            <t t-esc="row.floor"/>
                                            <small><t t-esc="row.free"/></small>
                                        </th>
                                        <t t-foreach="row.cells" t-as="c" t-key="c.section">
                                            <td class="o_vk_gsecCell">
                                                <div class="o_vk_grow">
                                                    <t t-foreach="c.units" t-as="u" t-key="u.id">
                                                        <button t-attf-class="o_vk_cell o_vk_{{u.vk_state}}"
                                                                t-att-class="{
                                                                    'o_vk_dim': u.dimmed,
                                                                    'o_vk_cell_on': state.unit and state.unit.id === u.id }"
                                                                t-on-click="() => this.selectUnit(u)"
                                                                t-att-title="u.default_code + ' · ' + u.vk_area_total + ' m²'">
                                                            <t t-esc="cellLabel(u)"/>
                                                        </button>
                                                    </t>
                                                </div>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- detail panel -->
                <div class="o_vk_side">
                    <t t-if="state.unit">
                        <div class="o_vk_upanel">
                            <div class="d-flex align-items-start justify-content-between">
                                <div>
                                    <div class="o_vk_kicker">Unit</div>
                                    <h3 class="o_vk_sel_n"><t t-esc="state.unit.default_code"/></h3>
                                </div>
                                <span t-attf-class="o_vk_badge o_vk_b_{{state.unit.vk_state}}">
                                    <t t-esc="state.unit.vk_state"/>
                                </span>
                            </div>

                            <div class="o_vk_price"><t t-esc="fmtMoney(state.unit.list_price)"/></div>
                            <div class="o_vk_permsq">
                                <t t-esc="fmtMoney(state.unit.vk_price_sqm)"/> / m²
                            </div>

                            <div class="o_vk_specs">
                                <div><span>Layout</span><b><t t-esc="state.unit.vk_rooms"/></b></div>
                                <div><span>Total</span><b><t t-esc="state.unit.vk_area_total"/> m²</b></div>
                                <div><span>Balcony</span><b><t t-esc="state.unit.vk_area_balcony"/> m²</b></div>
                                <div><span>Floor</span><b><t t-esc="state.unit.vk_floor"/></b></div>
                                <div t-if="state.unit.vk_section">
                                    <span>Section</span><b><t t-esc="state.unit.vk_section"/></b>
                                </div>
                                <div t-if="state.unit.vk_handover">
                                    <span>Handover</span><b><t t-esc="state.unit.vk_handover"/></b>
                                </div>
                            </div>

                            <button class="btn btn-primary btn-sm w-100 mt-3"
                                    t-on-click="() => this.openUnitRecord(state.unit)">
                                Open unit
                            </button>
                        </div>
                    </t>
                    <div t-else="" class="p-3 o_vk_row_m">
                        Pick a unit from the grid to see its details.
                    </div>
                </div>
            </div>

            <div t-elif="!state.view" class="p-4">
                <h4>Nothing to show for this step</h4>
                <p class="text-muted">
                    Add a <t t-esc="state.mode"/> view under
                    Estate → Configuration → Visual Views, or switch the step off
                    on the project.
                </p>
            </div>

            <div t-else="" class="o_vk_body d-flex flex-grow-1 overflow-hidden">

                <div class="o_vk_stage flex-grow-1 position-relative"
                     t-ref="stage"
                     t-att-class="{ 'o_vk_drawing': state.drawing }"
                     t-on-click="onStageClick">

                    <img t-if="imageSrc" t-att-src="imageSrc" t-ref="img"
                         class="o_vk_img" alt="View background"
                         t-on-load="onImageLoad"/>
                    <div t-else="" class="o_vk_noimg">
                        <div>
                            <strong>No image uploaded</strong>
                            <div class="small">
                                Open this view and upload the building render.
                            </div>
                        </div>
                    </div>

                    <!-- Sized onto the rendered image box, not the container:
                         object-fit letterboxes the image, so matching the
                         container would drift whenever the ratios differ. -->
                    <svg class="o_vk_svg" viewBox="0 0 1 1"
                         preserveAspectRatio="none"
                         t-attf-style="left:{{state.box.left}}px;top:{{state.box.top}}px;width:{{state.box.width}}px;height:{{state.box.height}}px">

                        <t t-foreach="state.zones" t-as="z" t-key="z.id">
                            <polygon class="o_vk_zone"
                                     t-att-class="{
                                        'o_vk_zone_sel': state.selected and state.selected.id === z.id,
                                        'o_vk_zone_edit': state.editing }"
                                     t-att-points="attr(z.pts)"
                                     t-on-click="() => this.onZoneClick(z)"
                                     t-on-pointerdown="(ev) => this.startDragZone(ev, z)"/>
                        </t>

                        <!-- Handles for the selected zone: corners to drag,
                             edge midpoints to add a bend. -->
                        <t t-if="state.editing and state.selected">
                            <t t-foreach="edgeMidpoints(state.selected.pts)" t-as="m" t-key="'m'+m.i">
                                <circle class="o_vk_mid"
                                        t-att-cx="m.x" t-att-cy="m.y" r="0.006"
                                        t-on-click.stop="() => this.addPointAfter(state.selected, m.i)">
                                    <title>Add a point here</title>
                                </circle>
                            </t>
                            <t t-foreach="state.selected.pts" t-as="p" t-key="p_index">
                                <circle class="o_vk_vtx"
                                        t-att-cx="p[0]" t-att-cy="p[1]" r="0.009"
                                        t-on-pointerdown="(ev) => this.startDragVertex(ev, state.selected, p_index)"
                                        t-on-contextmenu.prevent.stop="() => this.removePoint(state.selected, p_index)">
                                    <title>Drag to move · right-click to remove</title>
                                </circle>
                            </t>
                        </t>

                        <!-- In-progress shape. The first point is drawn larger:
                             clicking it again closes the polygon. -->
                        <t t-if="state.draft.length">
                            <polygon t-if="state.draft.length > 1"
                                     class="o_vk_draft" t-att-points="attr(state.draft)"/>
                            <t t-foreach="state.draft" t-as="p" t-key="p_index">
                                <circle t-att-class="p_index === 0 ? 'o_vk_vtx o_vk_first' : 'o_vk_vtx'"
                                        t-att-cx="p[0]" t-att-cy="p[1]"
                                        t-att-r="p_index === 0 ? 0.012 : 0.006"/>
                            </t>
                        </t>
                    </svg>
                </div>

                <div class="o_vk_side">
                    <div class="o_vk_side_h">Zones</div>
                    <div class="o_vk_list">
                        <t t-foreach="state.zones" t-as="z" t-key="z.id">
                            <div class="o_vk_row d-flex align-items-center"
                                 t-att-class="{ 'o_vk_row_sel': state.selected and state.selected.id === z.id }"
                                 t-on-click="() => this.onZoneClick(z)">
                                <span class="flex-grow-1">
                                    <span class="o_vk_row_n"><t t-esc="z.name"/></span>
                                    <span class="o_vk_row_m" t-if="z.product_tmpl_id">
                                        <t t-esc="z.product_tmpl_id[1]"/>
                                    </span>
                                    <span class="o_vk_row_m" t-elif="z.target_view_id">
                                        → <t t-esc="z.target_view_id[1]"/>
                                    </span>
                                    <span class="o_vk_row_m" t-elif="z.floor">
                                        Floor <t t-esc="z.floor"/>
                                    </span>
                                </span>
                                <span class="o_vk_dot" t-if="state.dirty.has(z.id)" title="Unsaved">●</span>
                                <button t-if="state.editing" class="o_vk_del"
                                        t-on-click.stop="() => this.deleteZone(z)"
                                        title="Delete zone">×</button>
                            </div>
                        </t>
                        <div t-if="!state.zones.length" class="o_vk_row_m p-3">
                            No zones on this view yet.
                        </div>
                    </div>

                    <div class="o_vk_act" t-if="state.selected">
                        <div class="o_vk_kicker">Selected</div>
                        <div class="o_vk_sel_n"><t t-esc="state.selected.name"/></div>

                        <div t-if="state.editing" class="d-flex gap-1 mt-2">
                            <button class="btn btn-secondary btn-sm flex-grow-1"
                                    t-on-click="() => this.nudge(-0.004)"
                                    title="Move up">↑</button>
                            <button class="btn btn-secondary btn-sm flex-grow-1"
                                    t-on-click="() => this.nudge(0.004)"
                                    title="Move down">↓</button>
                        </div>
                        <button t-if="state.editing"
                                class="btn btn-outline-danger btn-sm w-100 mt-2"
                                t-on-click="() => this.deleteZone(state.selected)">
                            Delete this zone
                        </button>
                        <button t-if="state.selected.product_tmpl_id"
                                class="btn btn-primary btn-sm w-100 mt-2"
                                t-on-click="() => this.openUnit(state.selected)">
                            Open unit
                        </button>
                        <button t-if="state.selected.floor"
                                class="btn btn-secondary btn-sm w-100 mt-2"
                                t-on-click="() => this.showFloorUnits(state.selected)">
                            Show units on this floor
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
