<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="vertikali.Selector">
        <div class="o_vk_selector d-flex flex-column h-100">

        <!-- Unit card: covers the selector while open, so the plan and the
             specs get the whole screen rather than a cramped sidebar. -->
        <div t-if="state.card" class="o_vk_card_full d-flex flex-column">
            <div class="o_vk_ch d-flex align-items-center gap-4 flex-wrap">
                <h2 class="o_vk_ch_t">Unit <t t-esc="state.card.default_code"/></h2>
                <div class="o_vk_ch_m">
                    <span>Area</span><b><t t-esc="state.card.vk_area_total"/> m²</b>
                </div>
                <div class="o_vk_ch_m">
                    <span>Price</span><b><t t-esc="fmtMoney(state.card.list_price)"/></b>
                </div>
                <div class="o_vk_ch_m">
                    <span>Per m²</span><b><t t-esc="fmtMoney(state.card.vk_price_sqm)"/></b>
                </div>
                <button class="o_vk_link ms-auto" t-on-click="closeCard">back ←</button>
            </div>

            <div class="o_vk_cb d-flex flex-grow-1 overflow-hidden">
                <div class="o_vk_cplan flex-grow-1 d-flex">
                    <div class="o_vk_cmodes">
                        <button class="o_vk_cmode"
                                t-att-class="{ 'o_vk_cmode_on': state.plan2d }"
                                t-on-click="() => (state.plan2d = true)">2D</button>
                        <button class="o_vk_cmode"
                                t-att-class="{ 'o_vk_cmode_on': !state.plan2d }"
                                t-on-click="() => (state.plan2d = false)">3D</button>
                    </div>
                    <div class="o_vk_cimg flex-grow-1">
                        <span class="o_vk_cph">
                            <t t-if="state.plan2d">2D plan — upload it on the product image</t>
                            <t t-else="">3D view not provided for this unit</t>
                        </span>
                    </div>
                </div>

                <div class="o_vk_cside">
                    <div class="o_vk_cmeta">
                        <t t-esc="state.card.vk_rooms"/>
                        <span class="o_vk_sep">|</span>
                        Floor <t t-esc="state.card.vk_floor"/>
                        <t t-if="state.block">
                            <span class="o_vk_sep">|</span> Block <t t-esc="state.block.code"/>
                        </t>
                    </div>

                    <div class="o_vk_crooms" t-if="cardRooms.length">
                        <t t-foreach="cardRooms" t-as="r" t-key="r_index">
                            <div>
                                <b t-if="r.area"><t t-esc="r.area"/> m²</b>
                                <b t-else="">—</b>
                                <span><t t-esc="r.label"/></span>
                            </div>
                        </t>
                    </div>
                    <div t-else="" class="o_vk_row_m mb-3">
                        No room breakdown entered for this unit.
                    </div>

                    <div class="o_vk_cfacts">
                        <div><span>Project</span><b t-esc="state.project ? state.project.name : '—'"/></div>
                        <div><span>Status</span>
                            <b t-attf-class="o_vk_badge o_vk_b_{{state.card.vk_state}}">
                                <t t-esc="state.card.vk_state"/></b>
                        </div>
                        <div t-if="state.card.vk_condition">
                            <span>Condition</span><b t-esc="state.card.vk_condition"/>
                        </div>
                        <div t-if="state.card.vk_area_balcony">
                            <span>Balcony</span><b><t t-esc="state.card.vk_area_balcony"/> m²</b>
                        </div>
                        <div t-if="state.card.vk_handover">
                            <span>Handover</span><b t-esc="state.card.vk_handover"/>
                        </div>
                    </div>

                    <button class="o_vk_cta" t-on-click="() => this.openUnitRecord(state.card)">
                        Open in Odoo
                    </button>

                    <!-- Where this unit sits on its floor. -->
                    <div class="o_vk_strip" t-if="floorStrip.length">
                        <div class="o_vk_kicker mb-1">Position on floor</div>
                        <div class="d-flex flex-wrap gap-1">
                            <t t-foreach="floorStrip" t-as="s" t-key="s.id">
                                <button t-attf-class="o_vk_sq o_vk_{{s.vk_state}}"
                                        t-att-class="{ 'o_vk_sq_on': s.current }"
                                        t-att-title="s.default_code"
                                        t-on-click="() => this.openCard(s)"></button>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>


            <!-- Breadcrumb + steps, once a project is chosen. -->
            <div class="o_vk_steps d-flex align-items-center gap-3 px-3 pt-2 flex-wrap"
                 t-if="state.project and !state.card">
                <div class="o_vk_crumb d-flex align-items-center gap-2">
                    <button class="o_vk_link" t-on-click="backToProjects"
                            t-if="state.projects.length > 1">← Projects</button>
                    <span class="o_vk_crumb_n"><t t-esc="state.project.name"/></span>
                    <t t-if="state.block">
                        <span class="o_vk_crumb_s">/</span>
                        <span class="o_vk_crumb_n">Block <t t-esc="state.block.code"/></span>
                        <!-- Back to the masterplan: without this the site plan
                             is unreachable once a block has been entered. -->
                        <button t-if="state.project.use_masterplan"
                                class="o_vk_link ms-1"
                                t-on-click="() => { state.block = null; state.mode = 'masterplan'; state.view = null; state.zones = []; }">
                            ↑ masterplan
                        </button>
                    </t>
                </div>

                <div class="o_vk_tabs d-flex" t-if="state.mode !== 'masterplan'">
                    <t t-foreach="steps" t-as="s" t-key="s.key">
                        <button t-if="s.key !== 'masterplan'" class="o_vk_tab"
                                t-att-class="{ 'o_vk_tab_on': state.mode === s.key }"
                                t-on-click="() => this.setMode(s.key)">
                            <span class="o_vk_tab_i"><t t-esc="s.icon"/></span>
                            <span><t t-esc="s.label"/></span>
                        </button>
                    </t>
                </div>

                <!-- Block switcher: coloured swatches, as on the render. -->
                <div class="o_vk_blocks d-flex align-items-center gap-2 ms-auto"
                     t-if="projectBlocks.length > 1">
                    <span class="o_vk_flabel">Block</span>
                    <t t-foreach="projectBlocks" t-as="b" t-key="b.id">
                        <button class="o_vk_bsw"
                                t-att-class="{ 'o_vk_bsw_on': state.block and state.block.id === b.id }"
                                t-attf-style="background:{{b.color}}"
                                t-on-click="() => this.selectBlock(b)"
                                t-att-title="b.name + ' — ' + b.available_count + ' free'">
                            <t t-esc="b.code"/>
                        </button>
                    </t>
                </div>
            </div>

            <!-- One t-if chain for the whole body: error and loading first, so
                 a failure is never hidden behind a half-rendered screen. -->
            <div t-if="state.card" class="d-none"></div>
            <div t-elif="state.error" class="alert alert-danger m-3"><t t-esc="state.error"/></div>
            <div t-elif="state.loading and !state.project" class="text-muted p-4">Loading…</div>

            <!-- Project chooser: cards, not a dropdown. -->
            <div t-elif="!state.project and state.projects.length"
                 class="o_vk_pick flex-grow-1 overflow-auto p-4">
                <h3 class="o_vk_pick_h">Choose a project</h3>
                <div class="o_vk_cards">
                    <t t-foreach="state.projects" t-as="p" t-key="p.id">
                        <button class="o_vk_card" t-on-click="() => this.selectProject(p)">
                            <span class="o_vk_card_img">
                                <img t-if="coverSrc(p)" t-att-src="coverSrc(p)" alt=""/>
                                <span t-else="" class="o_vk_card_ph">no cover</span>
                            </span>
                            <span class="o_vk_card_b">
                                <span class="o_vk_card_t"><t t-esc="p.name"/></span>
                                <span class="o_vk_card_s" t-if="p.tagline"><t t-esc="p.tagline"/></span>
                                <span class="o_vk_card_d" t-if="p.description"><t t-esc="p.description"/></span>
                                <span class="o_vk_card_stats">
                                    <span><b t-esc="p.available_count"/> free / <t t-esc="p.unit_count"/></span>
                                    <span t-if="p.price_from">from <b t-esc="fmtMoney(p.price_from)"/></span>
                                    <span t-if="p.handover"><t t-esc="p.handover"/></span>
                                </span>
                            </span>
                        </button>
                    </t>
                </div>
            </div>

            <!-- Masterplan: pick a block off the cover render. -->
            <div t-elif="state.mode === 'masterplan'" class="o_vk_body d-flex flex-grow-1 overflow-hidden">
                <div class="o_vk_stage flex-grow-1 position-relative" t-ref="stage"
                     t-att-class="{ 'o_vk_drawing': state.drawing }"
                     t-on-click="onStageClick">
                    <div t-if="!coverSrc(state.project)" class="o_vk_noimg">
                        <div>
                            <strong>No cover image</strong>
                            <div class="small">Upload one on the project to highlight blocks here.</div>
                        </div>
                    </div>
                    <!-- Image and overlay share one grid cell, so they line up
                         without any measured geometry. -->
                    <div t-else="" class="o_vk_frame" t-ref="frame">
                    <img t-att-src="coverSrc(state.project)"
                         t-ref="img" class="o_vk_img" alt="" t-on-load="onImageLoad"/>
                    <svg class="o_vk_svg" viewBox="0 0 1 1" preserveAspectRatio="none">
                        <!-- Existing outlines fade while a new one is traced,
                             so they cannot be mistaken for what is being drawn. -->
                        <t t-foreach="projectBlocks" t-as="b" t-key="b.id">
                            <polygon t-if="b.points" class="o_vk_bzone"
                                     t-att-class="{ 'o_vk_dim': state.drawing }"
                                     t-attf-style="fill:{{b.color}}"
                                     t-att-points="pointsAttr(b.points)"
                                     t-on-click="() => this.selectBlock(b)"/>
                        </t>

                        <!-- Corner handles while a block outline is being adjusted. -->
                        <t t-if="state.editingBlock and !state.drawing">
                            <t t-foreach="blockPoints(state.editingBlock)" t-as="p" t-key="p_index">
                                <circle class="o_vk_vtx" t-att-cx="p[0]" t-att-cy="p[1]" r="0.009"
                                        t-on-pointerdown="(ev) => this.startDragBlockVertex(ev, state.editingBlock, p_index)"/>
                            </t>
                        </t>

                        <!-- Shape being drawn. -->
                        <t t-if="state.draft.length">
                            <polygon t-if="state.draft.length > 1"
                                     class="o_vk_draft" t-att-points="attr(state.draft)"/>
                            <t t-foreach="state.draft" t-as="p" t-key="p_index">
                                <circle t-att-class="p_index === 0 ? 'o_vk_vtx o_vk_first' : 'o_vk_vtx'"
                                        t-att-cx="p[0]" t-att-cy="p[1]"
                                        t-att-r="p_index === 0 ? 0.012 : 0.006"/>
                            </t>
                        </t>
                    </svg>
                    </div>
                    <div class="o_vk_hint">
                        <t t-if="!projectBlocks.length">
                            No blocks yet — press <b>+ add</b> on the right, then
                            click the corners of a tower on the render.
                        </t>
                        <t t-elif="state.drawing">
                            Drawing <b>Block <t t-esc="state.editingBlock.code"/></b> —
                            <t t-esc="state.draft.length"/> points. Close on the first point to finish.
                            <button class="o_vk_link ms-2" t-on-click="undoPoint">undo</button>
                            <button class="o_vk_link ms-2" t-on-click="finishBlockDraw">finish</button>
                            <button class="o_vk_link ms-2"
                                    t-on-click="() => { state.drawing = false; state.draft = []; state.editingBlock = null; }">cancel</button>
                        </t>
                        <t t-elif="state.editingBlock">
                            Drag the corners of <b>Block <t t-esc="state.editingBlock.code"/></b> —
                            saved automatically.
                            <button class="o_vk_link ms-2"
                                    t-on-click="() => (state.editingBlock = null)">done</button>
                        </t>
                        <t t-else="">Pick a block on the render, or use the list on the right.</t>
                    </div>
                </div>
                <div class="o_vk_side">
                    <div class="o_vk_side_h d-flex align-items-center">
                        <span class="flex-grow-1">Blocks</span>
                        <button class="o_vk_link" t-on-click="startNewBlock">+ add</button>
                    </div>
                    <div class="o_vk_list">
                        <t t-foreach="projectBlocks" t-as="b" t-key="b.id">
                            <div class="o_vk_row"
                                 t-att-class="{ 'o_vk_row_sel': state.editingBlock and state.editingBlock.id === b.id }">
                                <div class="d-flex align-items-center gap-2"
                                     t-on-click="() => this.selectBlock(b)">
                                    <span class="o_vk_bsw" t-attf-style="background:{{b.color}}">
                                        <t t-esc="b.code"/>
                                    </span>
                                    <span class="flex-grow-1">
                                        <span class="o_vk_row_n"><t t-esc="b.name"/></span>
                                        <span class="o_vk_row_m">
                                            <t t-esc="b.available_count"/> free of <t t-esc="b.unit_count"/>
                                            <t t-if="b.floors"> · <t t-esc="b.floors"/> floors</t>
                                        </span>
                                    </span>
                                </div>
                                <!-- Shape controls: a block outline is edited
                                     here, not through the zone editor. -->
                                <div class="d-flex gap-2 mt-1 ms-4">
                                    <button class="o_vk_link"
                                            t-on-click.stop="() => this.startBlockDraw(b)">
                                        <t t-esc="b.points ? 'redraw' : 'draw shape'"/>
                                    </button>
                                    <button t-if="b.points" class="o_vk_link"
                                            t-on-click.stop="() => (state.editingBlock = b)">adjust</button>
                                    <button t-if="b.points" class="o_vk_link"
                                            t-on-click.stop="() => this.clearBlockShape(b)">clear shape</button>
                                    <button class="o_vk_link o_vk_link_d"
                                            t-on-click.stop="() => this.deleteBlock(b)">delete block</button>
                                </div>
                            </div>
                        </t>
                        <div t-if="!projectBlocks.length" class="o_vk_row_m p-3">
                            No blocks yet. Press <b>+ add</b> above, then click
                            the corners of the tower on the render.
                        </div>
                    </div>
                </div>
            </div>

            <!-- View toolbar: only for the image-backed steps. Rendering it on
                 the chooser or the masterplan put a stray bar above them. -->
            <div t-if="state.project and !state.card and isZoneMode"
                 class="o_vk_bar d-flex align-items-center gap-2 p-2 flex-wrap">
                <select t-if="modeViews.length > 1"
                        class="form-select form-select-sm w-auto"
                        t-on-change="(ev) => this.loadView(parseInt(ev.target.value))">
                    <t t-foreach="modeViews" t-as="v" t-key="v.id">
                        <option t-att-value="v.id"
                                t-att-selected="state.view and v.id === state.view.id">
                            <t t-esc="v.name"/>
                        </option>
                    </t>
                </select>
                <span t-elif="state.view" class="o_vk_kicker"><t t-esc="state.view.name"/></span>

                <!-- Back up a step after drilling into a floor. -->
                <button t-if="state.mode === 'floor' and state.project and state.project.use_facade"
                        class="btn btn-sm btn-link p-0"
                        t-on-click="() => this.setMode('facade')">
                    ← back to facade
                </button>

                <button t-if="isZoneMode" class="btn btn-sm"
                        t-att-class="state.editing ? 'btn-primary' : 'btn-secondary'"
                        t-on-click="toggleEdit">
                    <t t-esc="state.editing ? 'Editing zones' : 'Edit zones'"/>
                </button>

                <t t-if="state.editing and isZoneMode">
                    <button class="btn btn-sm btn-secondary" t-on-click="startDraw"
                            t-att-disabled="state.drawing">+ Draw zone</button>
                    <button class="btn btn-sm btn-secondary"
                            t-on-click="duplicateUp"
                            t-att-disabled="!state.selected or state.drawing"
                            title="Copy the selected zone one band higher">
                        Copy up
                    </button>
                    <button class="btn btn-sm btn-secondary"
                            t-on-click="duplicateDown"
                            t-att-disabled="!state.selected or state.drawing"
                            title="Copy the selected zone one band lower">
                        Copy down
                    </button>
                    <button class="btn btn-sm btn-secondary"
                            t-on-click="autoNumberZones"
                            t-att-disabled="!state.zones.length or state.drawing"
                            title="Number the zones downwards from a starting floor and link each to its plan">
                        Number floors…
                    </button>
                    <button class="btn btn-sm btn-secondary"
                            t-on-click="distributeBetweenEnds"
                            t-att-disabled="state.drawing"
                            title="Place the top and bottom zone, then spread the rest evenly between them">
                        Distribute
                    </button>
                    <button class="btn btn-sm btn-primary" t-on-click="saveShapes"
                            t-att-disabled="!state.dirty.size">
                        Save<t t-if="state.dirty.size"> (<t t-esc="state.dirty.size"/>)</t>
                    </button>
                    <button class="btn btn-sm btn-link text-danger"
                            t-on-click="deleteAllZones"
                            t-att-disabled="!state.zones.length">
                        Clear all
                    </button>
                </t>

                <span class="o_vk_meta">
                    <t t-esc="state.zones.length"/> zones
                </span>
            </div>

            <div t-if="state.editing and isZoneMode" class="o_vk_hint px-2 py-1">
                <t t-if="state.drawing">
                    <b>Click as many corners as you need</b> — follow the roofline
                    step by step. <t t-esc="state.draft.length"/> placed.
                    Finish by clicking the first point again, or:
                    <button class="btn btn-link btn-sm p-0 ms-2" t-on-click="undoPoint">undo point</button>
                    <button class="btn btn-link btn-sm p-0 ms-2" t-on-click="finishDraw">finish</button>
                    <button class="btn btn-link btn-sm p-0 ms-2" t-on-click="cancelDraw">cancel</button>
                </t>
                <t t-else="">
                    Trace one band with <b>+ Draw zone</b>, then <b>Copy up</b> /
                    <b>Copy down</b> to stack the facade. Give each band its
                    storey with <b>Number floors…</b> — a zone without a floor
                    opens nothing. Select a zone and press <b>Delete</b> to
                    remove it. Changes save on <b>Save</b>.
                </t>
            </div>

            <!-- New chain: the toolbar and hint above are plain siblings, so
                 a t-elif here would have no t-if to attach to and every branch
                 below it would silently never render. -->
            <div t-if="!state.project or state.card or state.mode === 'masterplan'"
                 class="d-none"></div>
            <div t-elif="state.loading" class="text-muted p-4">Loading…</div>

            <!-- Grid: no image, the units themselves are the interface. -->
            <div t-elif="state.mode === 'grid'" class="o_vk_body d-flex flex-grow-1 overflow-hidden">

                <div class="d-flex flex-column flex-grow-1 overflow-hidden">

                    <!-- filters -->
                    <div class="o_vk_filters d-flex align-items-center gap-3 px-3 py-2 flex-wrap">
                        <div class="d-flex align-items-center gap-1">
                            <span class="o_vk_flabel">Layout</span>
                            <t t-foreach="layouts" t-as="r" t-key="r">
                                <button class="o_vk_chip"
                                        t-att-class="{ 'o_vk_chip_on': state.filters.rooms.includes(r) }"
                                        t-on-click="() => this.toggleFilter('rooms', r)">
                                    <t t-esc="r"/>
                                </button>
                            </t>
                        </div>

                        <div class="d-flex align-items-center gap-1">
                            <span class="o_vk_flabel">Status</span>
                            <button class="o_vk_chip o_vk_chip_free"
                                    t-att-class="{ 'o_vk_chip_on': state.filters.status.includes('available') }"
                                    t-on-click="() => this.toggleFilter('status', 'available')">Free</button>
                            <button class="o_vk_chip o_vk_chip_res"
                                    t-att-class="{ 'o_vk_chip_on': state.filters.status.includes('reserved') }"
                                    t-on-click="() => this.toggleFilter('status', 'reserved')">Reserved</button>
                            <button class="o_vk_chip o_vk_chip_sold"
                                    t-att-class="{ 'o_vk_chip_on': state.filters.status.includes('sold') }"
                                    t-on-click="() => this.toggleFilter('status', 'sold')">Sold</button>
                        </div>

                        <div class="d-flex align-items-center gap-1">
                            <span class="o_vk_flabel">m²</span>
                            <input type="number" class="o_vk_num" placeholder="from"
                                   t-att-value="state.filters.areaMin"
                                   t-on-input="(ev) => (state.filters.areaMin = parseFloat(ev.target.value) || null)"/>
                            <input type="number" class="o_vk_num" placeholder="to"
                                   t-att-value="state.filters.areaMax"
                                   t-on-input="(ev) => (state.filters.areaMax = parseFloat(ev.target.value) || null)"/>
                        </div>

                        <div class="d-flex align-items-center gap-1">
                            <span class="o_vk_flabel">Max price</span>
                            <input type="number" class="o_vk_num o_vk_num_w" placeholder="any"
                                   t-att-value="state.filters.priceMax"
                                   t-on-input="(ev) => (state.filters.priceMax = parseFloat(ev.target.value) || null)"/>
                        </div>

                        <button t-if="filterActive" class="btn btn-sm btn-link p-0"
                                t-on-click="clearFilters">clear</button>

                        <span class="o_vk_meta ms-auto">
                            <t t-esc="matchCount"/> / <t t-esc="state.units.length"/> units
                        </span>
                    </div>

                    <!-- legend -->
                    <div class="o_vk_legend d-flex gap-3 px-3 py-1">
                        <span><i class="o_vk_sw o_vk_sw_free"></i>Free</span>
                        <span><i class="o_vk_sw o_vk_sw_res"></i>Reserved</span>
                        <span><i class="o_vk_sw o_vk_sw_sold"></i>Sold</span>
                    </div>

                    <div class="flex-grow-1 overflow-auto p-3">
                        <div t-if="!state.units.length" class="text-muted">
                            No units for this project yet.
                        </div>
                        <table t-else="" class="o_vk_gtable">
                            <thead>
                                <tr>
                                    <th class="o_vk_gcorner"></th>
                                    <t t-foreach="sections" t-as="s" t-key="s">
                                        <th class="o_vk_gsec">
                                            <t t-if="s">Section <t t-esc="s"/></t>
                                            <t t-else="">Units</t>
                                        </th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="gridRows" t-as="row" t-key="row.floor">
                                    <tr>
                                        <th class="o_vk_gfloor">
                                            <t t-esc="row.floor"/>
                                            <small><t t-esc="row.free"/></small>
                                        </th>
                                        <t t-foreach="row.cells" t-as="c" t-key="c.section">
                                            <td class="o_vk_gsecCell">
                                                <div class="o_vk_grow">
                                                    <t t-foreach="c.units" t-as="u" t-key="u.id">
                                                        <button t-attf-class="o_vk_cell o_vk_{{u.vk_state}}"
                                                                t-att-class="{
                                                                    'o_vk_dim': u.dimmed,
                                                                    'o_vk_cell_on': state.unit and state.unit.id === u.id }"
                                                                t-on-click="() => this.selectUnit(u)"
                                                                t-att-title="u.default_code + ' · ' + u.vk_area_total + ' m²'">
                                                            <t t-esc="cellLabel(u)"/>
                                                        </button>
                                                    </t>
                                                </div>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- detail panel -->
                <div class="o_vk_side">
                    <t t-if="state.unit">
                        <div class="o_vk_upanel">
                            <div class="d-flex align-items-start justify-content-between">
                                <div>
                                    <div class="o_vk_kicker">Unit</div>
                                    <h3 class="o_vk_sel_n"><t t-esc="state.unit.default_code"/></h3>
                                </div>
                                <span t-attf-class="o_vk_badge o_vk_b_{{state.unit.vk_state}}">
                                    <t t-esc="state.unit.vk_state"/>
                                </span>
                            </div>

                            <div class="o_vk_price"><t t-esc="fmtMoney(state.unit.list_price)"/></div>
                            <div class="o_vk_permsq">
                                <t t-esc="fmtMoney(state.unit.vk_price_sqm)"/> / m²
                            </div>

                            <div class="o_vk_specs">
                                <div><span>Layout</span><b><t t-esc="state.unit.vk_rooms"/></b></div>
                                <div><span>Total</span><b><t t-esc="state.unit.vk_area_total"/> m²</b></div>
                                <div><span>Balcony</span><b><t t-esc="state.unit.vk_area_balcony"/> m²</b></div>
                                <div><span>Floor</span><b><t t-esc="state.unit.vk_floor"/></b></div>
                                <div t-if="state.unit.vk_section">
                                    <span>Section</span><b><t t-esc="state.unit.vk_section"/></b>
                                </div>
                                <div t-if="state.unit.vk_handover">
                                    <span>Handover</span><b><t t-esc="state.unit.vk_handover"/></b>
                                </div>
                            </div>

                            <button class="btn btn-primary btn-sm w-100 mt-3"
                                    t-on-click="() => this.openUnitRecord(state.unit)">
                                Open unit
                            </button>
                        </div>
                    </t>
                    <div t-else="" class="p-3 o_vk_row_m">
                        Pick a unit from the grid to see its details.
                    </div>
                </div>
            </div>

            <div t-elif="!state.view" class="p-4">
                <h4>Nothing to show for this step</h4>
                <p class="text-muted">
                    Add a <t t-esc="state.mode"/> view under
                    Estate → Configuration → Visual Views, or switch the step off
                    on the project.
                </p>
            </div>

            <div t-else="" class="o_vk_body d-flex flex-grow-1 overflow-hidden">

                <div class="o_vk_stage flex-grow-1 position-relative"
                     t-ref="stage"
                     t-att-class="{ 'o_vk_drawing': state.drawing }"
                     t-on-click="onStageClick">

                    <div t-if="!imageSrc" class="o_vk_noimg">
                        <div>
                            <strong>No image uploaded</strong>
                            <div class="small">
                                Open this view and upload the building render.
                            </div>
                        </div>
                    </div>

                    <!-- Image and overlay share one grid cell, so the zones
                         always cover exactly the picture. -->
                    <div t-else="" class="o_vk_frame" t-ref="frame">
                    <img t-att-src="imageSrc" t-ref="img"
                         class="o_vk_img" alt="View background"
                         t-on-load="onImageLoad"/>
                    <svg class="o_vk_svg" viewBox="0 0 1 1"
                         preserveAspectRatio="none">

                        <t t-foreach="state.zones" t-as="z" t-key="z.id">
                            <t t-set="zu" t-value="zoneUnit(z)"/>
                            <polygon class="o_vk_zone"
                                     t-att-class="{
                                        'o_vk_zone_sel': state.selected and state.selected.id === z.id,
                                        'o_vk_zone_edit': state.editing,
                                        'o_vk_uz': zu,
                                        'o_vk_uz_free': zu and zu.vk_state === 'available',
                                        'o_vk_uz_res': zu and zu.vk_state === 'reserved',
                                        'o_vk_uz_sold': zu and zu.vk_state === 'sold' }"
                                     t-att-points="attr(z.pts)"
                                     t-on-click="() => this.onZoneClick(z)"
                                     t-on-pointerdown="(ev) => this.startDragZone(ev, z)"/>
                        </t>

                        <!-- Unit marker: number when free, a lock when taken,
                             mirroring how a sold flat reads on a printed plan. -->
                        <t t-if="!state.editing">
                            <t t-foreach="state.zones" t-as="z" t-key="'m'+z.id">
                                <t t-set="zu" t-value="zoneUnit(z)"/>
                                <t t-if="zu and z.pts.length">
                                    <t t-set="cx" t-value="z.pts.reduce((s,p) => s + p[0], 0) / z.pts.length"/>
                                    <t t-set="cy" t-value="z.pts.reduce((s,p) => s + p[1], 0) / z.pts.length"/>
                                    <circle t-att-cx="cx" t-att-cy="cy" r="0.018"
                                            t-attf-class="o_vk_pin o_vk_pin_{{zu.vk_state}}"
                                            t-on-click="() => this.openCard(zu)"/>
                                    <text t-att-x="cx" t-att-y="cy" class="o_vk_pin_t"
                                          text-anchor="middle" dominant-baseline="central">
                                        <t t-if="zu.vk_state === 'available'">
                                            <t t-esc="zu.default_code.slice(-3)"/>
                                        </t>
                                        <t t-else="">🔒</t>
                                    </text>
                                </t>
                            </t>
                        </t>

                        <!-- Handles for the selected zone: corners to drag,
                             edge midpoints to add a bend. -->
                        <t t-if="state.editing and state.selected">
                            <t t-foreach="edgeMidpoints(state.selected.pts)" t-as="m" t-key="'m'+m.i">
                                <circle class="o_vk_mid"
                                        t-att-cx="m.x" t-att-cy="m.y" r="0.006"
                                        t-on-click.stop="() => this.addPointAfter(state.selected, m.i)">
                                    <title>Add a point here</title>
                                </circle>
                            </t>
                            <t t-foreach="state.selected.pts" t-as="p" t-key="p_index">
                                <circle class="o_vk_vtx"
                                        t-att-cx="p[0]" t-att-cy="p[1]" r="0.009"
                                        t-on-pointerdown="(ev) => this.startDragVertex(ev, state.selected, p_index)"
                                        t-on-contextmenu.prevent.stop="() => this.removePoint(state.selected, p_index)">
                                    <title>Drag to move · right-click to remove</title>
                                </circle>
                            </t>
                        </t>

                        <!-- In-progress shape. The first point is drawn larger:
                             clicking it again closes the polygon. -->
                        <t t-if="state.draft.length">
                            <polygon t-if="state.draft.length > 1"
                                     class="o_vk_draft" t-att-points="attr(state.draft)"/>
                            <t t-foreach="state.draft" t-as="p" t-key="p_index">
                                <circle t-att-class="p_index === 0 ? 'o_vk_vtx o_vk_first' : 'o_vk_vtx'"
                                        t-att-cx="p[0]" t-att-cy="p[1]"
                                        t-att-r="p_index === 0 ? 0.012 : 0.006"/>
                            </t>
                        </t>
                    </svg>
                    </div>

                    <!-- Floor stepper, as on a printed plan: the storey you
                         are on, with its neighbours faded above and below. -->
                    <div class="o_vk_fstep" t-if="state.mode === 'floor' and floorList.length > 1">
                        <button class="o_vk_fbtn" t-on-click="() => this.stepFloor(1)"
                                title="Floor up">⌃</button>
                        <t t-foreach="floorList" t-as="fv" t-key="fv.id">
                            <button t-if="Math.abs(fv.floor - state.view.floor) &lt;= 2"
                                    class="o_vk_fnum"
                                    t-att-class="{ 'o_vk_fnum_on': fv.id === state.view.id }"
                                    t-on-click="() => this.loadView(fv.id)">
                                <t t-esc="fv.floor"/>
                            </button>
                        </t>
                        <button class="o_vk_fbtn" t-on-click="() => this.stepFloor(-1)"
                                title="Floor down">⌄</button>
                        <div class="o_vk_flabel2">floor</div>
                    </div>
                </div>

                <div class="o_vk_side">
                    <div class="o_vk_side_h">Zones</div>
                    <div class="o_vk_list">
                        <t t-foreach="state.zones" t-as="z" t-key="z.id">
                            <div class="o_vk_row d-flex align-items-center"
                                 t-att-class="{ 'o_vk_row_sel': state.selected and state.selected.id === z.id }"
                                 t-on-click="() => this.onZoneClick(z)">
                                <span class="flex-grow-1">
                                    <span class="o_vk_row_n"><t t-esc="z.name"/></span>
                                    <span class="o_vk_row_m" t-if="z.product_tmpl_id">
                                        <t t-esc="z.product_tmpl_id[1]"/>
                                    </span>
                                    <span class="o_vk_row_m" t-elif="z.target_view_id">
                                        → <t t-esc="z.target_view_id[1]"/>
                                    </span>
                                    <span class="o_vk_row_m" t-elif="z.floor">
                                        Floor <t t-esc="z.floor"/>
                                    </span>
                                </span>
                                <span class="o_vk_dot" t-if="state.dirty.has(z.id)" title="Unsaved">●</span>
                                <button t-if="state.editing" class="o_vk_del"
                                        t-on-click.stop="() => this.deleteZone(z)"
                                        title="Delete zone">×</button>
                            </div>
                        </t>
                        <div t-if="!state.zones.length" class="o_vk_row_m p-3">
                            No zones on this view yet.
                        </div>
                    </div>

                    <div class="o_vk_act" t-if="state.selected">
                        <div class="o_vk_kicker">Selected</div>
                        <div class="o_vk_sel_n"><t t-esc="state.selected.name"/></div>

                        <div t-if="state.editing" class="d-flex gap-1 mt-2">
                            <button class="btn btn-secondary btn-sm flex-grow-1"
                                    t-on-click="() => this.nudge(-0.004)"
                                    title="Move up">↑</button>
                            <button class="btn btn-secondary btn-sm flex-grow-1"
                                    t-on-click="() => this.nudge(0.004)"
                                    title="Move down">↓</button>
                        </div>
                        <!-- Which floor this zone opens. Without it the zone
                             is drawn but leads nowhere. -->
                        <div t-if="state.editing and state.mode === 'facade'" class="mt-2">
                            <label class="o_vk_kicker d-block mb-1">Opens floor</label>
                            <input type="number" class="o_vk_num w-100"
                                   t-att-value="state.selected.floor or ''"
                                   placeholder="e.g. 12"
                                   t-on-change="(ev) => this.assignFloor(state.selected, ev.target.value)"/>
                        </div>

                        <button t-if="state.editing"
                                class="btn btn-outline-danger btn-sm w-100 mt-2"
                                t-on-click="() => this.deleteZone(state.selected)">
                            Delete this zone
                        </button>
                        <button t-if="state.selected.product_tmpl_id"
                                class="btn btn-primary btn-sm w-100 mt-2"
                                t-on-click="() => this.openUnit(state.selected)">
                            Open unit
                        </button>
                        <button t-if="state.selected.floor"
                                class="btn btn-secondary btn-sm w-100 mt-2"
                                t-on-click="() => this.showFloorUnits(state.selected)">
                            Show units on this floor
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
